node_modules
public/css/styles.css

# Secrets: only .env.example (empty placeholders) is committed
.env
.env.*
!.env.example

# Local database and customer data - never commit
data/*.db
data/*.db-*
data/orders.json

# Backups made by npm run images:optimize
data/image-originals/
data/backups/

# Ops workspace (agents): customer data and generated reports stay local
ops/data/*.csv
!ops/data/settings.csv
ops/tickets/
ops/reports/
ops/confirmations/
ops/reviews/

# ops helper caches (public pincode data)
ops/cache/
