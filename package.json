{
  "name": "mythosbyss",
  "version": "1.0.0",
  "description": "MythosBySS e-commerce storefront (Node.js, Express, EJS, Tailwind, Razorpay)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently -k \"npm:dev:css\" \"npm:dev:server\"",
    "dev:server": "nodemon server.js --ignore data/ --ignore public/",
    "dev:css": "tailwindcss -i ./src/input.css -o ./public/css/styles.css --watch",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/css/styles.css --minify",
    "postinstall": "npm run build:css",
    "slugs": "node scripts/list-slugs.js"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "compression": "^1.7.4",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.0",
    "helmet": "^7.1.0",
    "razorpay": "^2.9.4",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.4"
  }
}
