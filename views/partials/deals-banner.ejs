<%# "Hot Deals" ribbon for the New arrivals section. Expects deals = { title, sub, upto } %>
<div class="relative overflow-hidden rounded-2xl bg-gradient-to-r from-[#7a1f12] via-[#c2410c] to-[#f59e0b] text-white px-5 py-4 md:px-8 md:py-5 mb-8 flex flex-wrap items-center gap-x-6 gap-y-2 shadow-sm">
  <span aria-hidden="true" class="absolute -right-6 -top-8 w-32 h-32 rounded-full bg-white/10"></span>
  <span aria-hidden="true" class="absolute right-24 -bottom-10 w-24 h-24 rounded-full bg-white/10"></span>
  <p class="relative flex items-center gap-2 text-xl md:text-2xl font-display font-semibold tracking-tight">
    <svg class="w-6 h-6 md:w-7 md:h-7" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 2s.9 3.1-1.3 6c-1.2 1.6-3.2 2.6-3.2 5.4A3.6 3.6 0 0 0 12.6 17c-1.6-1.9-.2-4 1.3-5.2 0 2.3 3.1 3.1 3.1 6.1A5 5 0 0 1 12 22.9 7.5 7.5 0 0 1 4.5 15.3C4.5 9 11.3 7.6 13.5 2Z"/></svg>
    <%= deals.title %>
  </p>
  <% if (deals.sub) { %><p class="relative text-sm md:text-base text-white/90 flex-1 min-w-[12rem]"><%= deals.sub %></p><% } %>
  <% if (deals.upto >= 5) { %><span class="relative inline-flex items-center rounded-full bg-white text-[#9a3412] px-4 py-1.5 text-sm font-bold whitespace-nowrap">Up to <%= deals.upto %>% off</span><% } %>
</div>
