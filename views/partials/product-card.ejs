<article class="group flex flex-col">
  <a href="/products/<%= p.slug %>" class="relative block aspect-square overflow-hidden rounded-xl bg-paper">
    <img src="<%= p.image %>" alt="<%= p.name %>" loading="lazy" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105">
    <% if (p.isNew) { %><span class="absolute top-3 left-3 bg-ink text-white text-xs font-semibold px-2.5 py-1 rounded-full">New</span><% } %>
    <span class="absolute top-3 right-3 bg-gold text-white text-xs font-semibold px-2.5 py-1 rounded-full">Save <%= p.discount %>%</span>
  </a>
  <div class="pt-3 flex-1 flex flex-col">
    <p class="text-xs text-neutral-500"><%= p.categoryName %></p>
    <h3 class="font-display text-lg leading-snug mt-0.5"><a href="/products/<%= p.slug %>" class="hover:text-gold-dark"><%= p.name %></a></h3>
    <p class="mt-1.5 text-sm">
      <% if (p.multi) { %><span class="text-neutral-500">From </span><% } %>
      <span class="font-semibold"><%= money(p.price) %></span>
      <span class="text-neutral-400 line-through ml-1.5"><%= money(p.mrp) %></span>
    </p>
    <a href="/products/<%= p.slug %>" class="btn-outline mt-3 py-2 text-xs">View product</a>
  </div>
</article>
