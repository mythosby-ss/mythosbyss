</main>
<footer class="mt-16 bg-black text-neutral-200">
  <div class="container-x py-10 md:py-12">
    <div class="grid gap-9 md:grid-cols-[1.35fr_0.8fr] md:gap-16">
      <section aria-labelledby="footer-brand">
        <a href="/" class="inline-flex items-center gap-3">
          <img src="/images/logo/Mythos_Logo_TM.png" alt="" class="h-16 w-auto max-w-[78px] object-contain invert" width="78" height="70" loading="lazy">
          <span id="footer-brand" class="text-xl font-medium tracking-wide">MYTHOS BY SS</span>
        </a>
        <p class="mt-4 max-w-2xl text-sm leading-6 text-neutral-300">MythosBySS brings you quality everyday essentials for your home, kitchen, hydration and gifting needs. Discover useful products designed to combine function, style and value.</p>
        <div class="mt-5 flex flex-wrap gap-3 text-sm">
          <a class="rounded-full border border-white/30 px-4 py-2 transition hover:border-white hover:text-white" href="/products">Shop all products</a>
          <a class="rounded-full border border-white/30 px-4 py-2 transition hover:border-white hover:text-white" href="/pages/contact">Contact us</a>
        </div>
      </section>

      <section aria-labelledby="footer-contact">
        <h2 id="footer-contact" class="mb-3 text-lg font-semibold text-white">Contact Us</h2>
        <ul class="space-y-2.5 text-sm leading-6 text-neutral-300">
          <% if (support.phone) { %><li><span class="text-white">Call:</span> <a class="hover:text-white" href="tel:+91<%= support.phone %>">+91 <%= support.phone %></a></li><% } %>
          <% if (support.whatsapp) { %><li><span class="text-white">WhatsApp:</span> <a class="hover:text-white" href="<%= support.waLink %>" target="_blank" rel="noopener noreferrer">+91 <%= support.whatsapp %></a></li><% } %>
          <% if (support.email) { %><li><span class="text-white">Email:</span> <a class="break-all hover:text-white" href="mailto:<%= support.email %>"><%= support.email %></a></li><% } %>
          <li><span class="text-white">Customer support:</span> WhatsApp us for the fastest reply.</li>
          <li><span class="text-white">Address:</span> H.N. No. 37D/JRB/25, Jaganpura, Jay Ram Bagh Mauza, Agra, Uttar Pradesh 282005, India.</li>
        </ul>
      </section>
    </div>

    <nav class="mt-9 border-y border-white/30 py-4" aria-label="Customer information">
      <div class="flex flex-wrap gap-x-8 gap-y-3 text-sm font-medium">
        <a class="hover:text-white" href="/pages/about-us">About Us</a>
        <a class="hover:text-white" href="/pages/returns">Return Policy</a>
        <a class="hover:text-white" href="/pages/terms">Terms &amp; Conditions</a>
        <a class="hover:text-white" href="/pages/privacy-policy">Privacy Policy</a>
        <a class="hover:text-white" href="/pages/shipping-policy">Shipping Policy</a>
        <a class="hover:text-white" href="/pages/cod-policy">COD Policy</a>
        <a class="hover:text-white" href="/pages/contact">Contact</a>
        <a class="hover:text-white" href="/track">Track Order</a>
      </div>
    </nav>

    <div class="mt-5 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs sm:text-sm">
        <span class="font-semibold text-white">Explore</span>
        <a class="hover:text-white" href="/collections/water-bottle">Water Bottles</a>
        <a class="hover:text-white" href="/collections/lunch-box">Lunch Boxes</a>
        <a class="hover:text-white" href="/products">Best Sellers</a>
        <a class="hover:text-white" href="/new-arrivals">New Arrivals</a>
        <% categories.slice(0,3).forEach((c) => { %><a class="hover:text-white" href="/collections/<%= c.slug %>"><%= c.name %></a><% }) %>
      </div>

      <div
        class="flex flex-wrap items-center gap-2"
        aria-label="Accepted payment methods"
      >
        <% const paymentMethods = [
          { name: 'PhonePe', logo: '/images/payments/phonepe.svg' },
          { name: 'Google Pay', logo: '/images/payments/google-pay.svg' },
          { name: 'Paytm', logo: '/images/payments/paytm.svg' },
          { name: 'UPI', logo: '/images/payments/upi.svg' },
          { name: 'RuPay', logo: '/images/payments/rupay.svg' },
          { name: 'Mastercard', logo: '/images/payments/mastercard.svg' },
          { name: 'Visa', logo: '/images/payments/visa.svg' }
        ]; %>

        <% paymentMethods.forEach(method => { %>
          <div
            class="flex h-10 min-w-[72px] items-center justify-center rounded-sm bg-white px-2.5"
            title="<%= method.name %>"
          >
            <img
              src="<%= method.logo %>"
              alt="<%= method.name %>"
              class="h-5 w-auto max-w-[62px] object-contain"
              width="62"
              height="24"
              loading="lazy"
            >
          </div>
        <% }); %>
      </div>

    </div>
  </div>
  <div class="border-t border-white/20 px-4 py-5 text-center text-xs text-neutral-400">
    &copy; <%= new Date().getFullYear() %> MythosBySS&trade;. All rights reserved.
  </div>
</footer>
<% if (support.button) { %>
<a href="<%= support.waLink %>" target="_blank" rel="noopener noreferrer" aria-label="Chat with us on WhatsApp"
   class="fixed bottom-5 right-5 z-40 flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lg transition hover:scale-105 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#25D366]">
  <svg viewBox="0 0 32 32" class="h-8 w-8" fill="currentColor" aria-hidden="true"><path d="M16 3C8.8 3 3 8.7 3 15.8c0 2.5.7 4.9 2 7L3 29l6.4-2c2 1.1 4.3 1.7 6.6 1.7 7.2 0 13-5.7 13-12.8S23.2 3 16 3zm0 23.4c-2.1 0-4.1-.6-5.8-1.6l-.4-.2-3.8 1.2 1.2-3.7-.3-.4c-1.2-1.8-1.8-3.8-1.8-5.9C5.1 10 10 5.2 16 5.2S26.9 10 26.9 15.9 22 26.4 16 26.4zm6-7.8c-.3-.2-1.9-1-2.2-1.1-.3-.1-.5-.2-.7.2-.2.3-.8 1-1 1.2-.2.2-.4.2-.7.1-.3-.2-1.4-.5-2.6-1.6-1-.9-1.6-1.9-1.8-2.2-.2-.3 0-.5.1-.7l.5-.6c.2-.2.2-.4.3-.6.1-.2 0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.1-1.2 2.8s1.2 3.2 1.4 3.5c.2.2 2.4 3.6 5.8 5 .8.3 1.4.5 1.9.7.8.2 1.5.2 2.1.1.6-.1 1.9-.8 2.2-1.5.3-.7.3-1.4.2-1.5-.1-.2-.3-.3-.6-.4z"/></svg>
</a>
<% } %>
<script src="/js/app.js?v=<%= assetV %>" defer></script>
<% if (typeof scripts !== 'undefined') { scripts.forEach((s) => { %><script src="<%= s.startsWith('/') ? s + '?v=' + assetV : s %>" defer></script><% }) } %>
</body>
</html>
