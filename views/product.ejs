<%- include('partials/header') %>
<div class="container-x pt-6 text-sm text-neutral-500" aria-label="Breadcrumb">
  <a href="/" class="hover:text-ink">Home</a> / <a href="/collections/<%= product.category %>" class="hover:text-ink"><%= product.categoryName %></a> / <span class="text-ink"><%= product.name %></span>
</div>

<section class="container-x py-8 grid lg:grid-cols-2 gap-10 lg:gap-16"
  data-product
  data-variants="<%= JSON.stringify(product.variants.map(v => ({ sku: v.sku, price: v.price, mrp: v.mrp, label: v.label, code: v.code, pack: v.pack }))) %>">
  <!-- Gallery -->
  <div>
    <div class="aspect-square rounded-2xl overflow-hidden bg-paper border border-neutral-200">
      <img data-main-image src="<%= product.images[0] %>" alt="<%= product.name %>" class="w-full h-full object-cover">
    </div>
    <% if (product.images.length > 1) { %>
    <div class="mt-3 grid grid-cols-5 gap-3">
      <% product.images.forEach((src, i) => { %>
        <button type="button" data-thumb="<%= src %>" class="aspect-square rounded-lg overflow-hidden border <%= i === 0 ? 'border-ink' : 'border-neutral-200' %>" aria-label="Show image <%= i + 1 %>"><img src="<%= src %>" alt="" class="w-full h-full object-cover" loading="lazy"></button>
      <% }) %>
    </div>
    <% } %>
  </div>

  <!-- Buy box -->
  <div>
    <% if (product.badge) { %><p class="inline-block bg-gold-soft text-gold-dark text-xs font-semibold px-3 py-1 rounded-full mb-3"><%= product.badge %></p><% } %>
    <h1 class="text-4xl md:text-5xl font-semibold leading-tight"><%= product.name %></h1>
    <% if (reviews.length) { %><p class="mt-3 flex items-center gap-2 text-sm"><%- include('partials/stars', { n: Math.round(reviews.reduce((s, r) => s + r.rating, 0) / reviews.length) }) %> <span class="text-neutral-600"><%= reviews.length %> review<%= reviews.length > 1 ? 's' : '' %></span></p><% } %>

    <p class="mt-5 flex items-baseline flex-wrap gap-3">
      <span data-price class="text-3xl font-semibold"><%= money(initial.price) %></span>
      <span data-mrp class="text-lg text-neutral-400 line-through"><%= money(initial.mrp) %></span>
      <span class="bg-gold text-white text-xs font-semibold px-2.5 py-1 rounded-full">Save <%= product.discount %>%</span>
    </p>
    <p class="text-xs text-neutral-500 mt-1">Inclusive of all taxes. Free shipping.</p>

    <form method="post" action="/cart/add" class="mt-6" data-buy-form>
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input type="hidden" name="slug" value="<%= product.slug %>">
      <input type="hidden" name="sku" value="<%= initial.sku %>" data-sku>

      <fieldset>
        <legend class="label"><%= product.variants.length > 1 ? 'Choose a size' : 'Size' %></legend>
        <div class="flex flex-wrap gap-2">
          <% product.variants.forEach((v) => { %>
          <label class="cursor-pointer">
            <input type="radio" name="variant" value="<%= v.sku %>" class="peer sr-only" <%= v.sku === initial.sku ? 'checked' : '' %>>
            <span class="block px-4 py-2.5 text-sm rounded-lg border border-neutral-300 peer-checked:border-ink peer-checked:bg-ink peer-checked:text-white peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-gold hover:border-ink"><%= v.label %></span>
          </label>
          <% }) %>
        </div>
      </fieldset>

      <div class="mt-6">
        <label class="label" for="qty">Quantity</label>
        <div class="inline-flex items-center border border-neutral-300 rounded-full">
          <button type="button" data-qty-dec class="w-11 h-11 text-xl" aria-label="Decrease quantity">&minus;</button>
          <input id="qty" name="qty" type="number" min="1" max="10" value="1" inputmode="numeric" class="w-12 text-center bg-transparent outline-none [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none" data-qty>
          <button type="button" data-qty-inc class="w-11 h-11 text-xl" aria-label="Increase quantity">+</button>
        </div>
      </div>

      <div class="mt-7 grid sm:grid-cols-2 gap-3">
        <button type="submit" data-add-to-cart class="btn-outline py-4 text-base">Add to cart</button>
        <button type="submit" formaction="/cart/buy-now" class="btn-dark py-4 text-base">Buy now</button>
      </div>
    </form>

    <!-- Delivery check -->
    <div class="mt-8 border border-neutral-200 rounded-xl p-5">
      <p class="font-semibold text-sm">Check delivery</p>
      <form data-pincode class="mt-3 flex gap-2">
        <label class="sr-only" for="pin">Pincode</label>
        <input id="pin" inputmode="numeric" maxlength="6" placeholder="Enter 6-digit pincode" class="field">
        <button class="btn-dark px-6">Check</button>
      </form>
      <p data-pin-result class="mt-3 text-sm hidden"></p>
    </div>

    <ul class="mt-6 grid grid-cols-2 gap-3 text-sm text-neutral-700">
      <li class="flex gap-2"><span class="text-gold">&#10003;</span> BPA free, food grade</li>
      <li class="flex gap-2"><span class="text-gold">&#10003;</span> Cash on delivery available</li>
      <li class="flex gap-2"><span class="text-gold">&#10003;</span> Partial COD available</li>
      <li class="flex gap-2"><span class="text-gold">&#10003;</span> 7-day damage replacement</li>
    </ul>
  </div>
</section>

<!-- Details -->
<section class="container-x pt-6 grid lg:grid-cols-2 gap-10">
  <div>
    <h2 class="text-2xl font-semibold">About this product</h2>
    <p class="mt-3 text-neutral-700 leading-relaxed max-w-prose"><%= product.description %></p>
    <% if (product.features.length) { %>
      <ul class="mt-5 space-y-2 text-neutral-700">
        <% product.features.forEach((f) => { %><li class="flex gap-2"><span class="text-gold">&#8226;</span><%= f %></li><% }) %>
      </ul>
    <% } %>
  </div>
  <div>
    <h2 class="text-2xl font-semibold">Specifications</h2>
    <div class="mt-3 overflow-x-auto">
      <table class="w-full text-sm border border-neutral-200 rounded-lg">
        <thead class="bg-paper text-left"><tr><th class="p-3 font-semibold">Size</th><th class="p-3 font-semibold">SKU</th><th class="p-3 font-semibold">Price</th></tr></thead>
        <tbody>
          <% product.variants.forEach((v) => { %><tr class="border-t border-neutral-200"><td class="p-3"><%= v.label %></td><td class="p-3 text-neutral-600"><%= v.sku %></td><td class="p-3"><%= money(v.price) %></td></tr><% }) %>
        </tbody>
      </table>
    </div>
    <dl class="mt-4 grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 text-sm">
      <dt class="text-neutral-500">Category</dt><dd><%= product.categoryName %></dd>
      <dt class="text-neutral-500">Material</dt><dd>BPA-free, food-grade materials</dd>
      <dt class="text-neutral-500">Brand</dt><dd>MythosBySS</dd>
    </dl>
  </div>
</section>

<% if (reviews.length) { %>
<section class="container-x pt-14">
  <h2 class="text-2xl font-semibold">Customer reviews</h2>
  <div class="mt-5 grid md:grid-cols-2 gap-5">
    <% reviews.forEach((r) => { %>
      <div class="border border-neutral-200 rounded-xl p-5"><%- include('partials/stars', { n: r.rating }) %><p class="font-display text-lg mt-2"><%= r.title %></p><p class="text-sm text-neutral-700 mt-1"><%= r.text %></p><p class="text-sm mt-3 font-semibold"><%= r.name %> <span class="font-normal text-neutral-500">from <%= r.city %></span></p></div>
    <% }) %>
  </div>
</section>
<% } %>

<% if (related.length) { %>
<section class="container-x pt-16">
  <h2 class="text-2xl md:text-3xl font-semibold mb-6">More from <%= product.categoryName.toLowerCase() %></h2>
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-4 gap-y-10">
    <% related.forEach((p) => { %><%- include('partials/product-card', { p }) %><% }) %>
  </div>
</section>
<% } %>

<script type="application/ld+json"><%- JSON.stringify({ '@context': 'https://schema.org', '@type': 'Product', name: product.name, description: product.description, brand: { '@type': 'Brand', name: 'MythosBySS' }, sku: initial.sku, offers: { '@type': 'AggregateOffer', priceCurrency: 'INR', lowPrice: product.price, offerCount: product.variants.length, availability: 'https://schema.org/InStock' } }).replace(/</g, '\\u003c') %></script>
<%- include('partials/footer') %>
