<%- include('partials/header') %>
<script type="application/json" id="mb-event"><%- JSON.stringify({ name: 'view_item', value: initial.price, items: [{ id: initial.sku, name: product.name, variant: initial.label, price: initial.price, qty: 1 }] }).replace(/</g, '\\u003c') %></script>
<% // Gallery shows the WebP copy when one exists (all current browsers); feeds / WhatsApp previews keep the JPG/PNG
   const disp = (u) => webp(u) || u;
   const galleryImages = (initial.images.length ? initial.images : product.images).map(disp); %>
<div class="container-x pt-6 text-sm text-neutral-500" aria-label="Breadcrumb">
  <a href="/" class="hover:text-ink">Home</a> / <a href="/collections/<%= product.category %>" class="hover:text-ink"><%= product.categoryName %></a> / <span class="text-ink"><%= product.name %></span>
</div>

<section class="container-x py-8 grid lg:grid-cols-2 gap-10 lg:gap-16"
  data-product
  data-product-images="<%= JSON.stringify(product.images.map(disp)) %>"
  data-variants="<%= JSON.stringify(product.variants.map(v => ({ sku: v.sku, price: v.price, mrp: v.mrp, label: v.label, code: v.code, pack: v.pack, stock: v.stock, images: v.images.map(disp) }))) %>">
  <!-- Gallery -->
  <div data-gallery>
    <div class="aspect-square rounded-2xl overflow-hidden bg-paper border border-neutral-200">
      <img data-main-image src="<%= galleryImages[0] %>" alt="<%= product.imageAlt %>" class="w-full h-full object-cover" width="800" height="800" fetchpriority="high" decoding="async">
    </div>
    <% if (galleryImages.length > 1) { %>
    <div class="mt-3 grid grid-cols-5 gap-3">
      <% galleryImages.forEach((src, i) => { %>
        <button type="button" data-thumb="<%= src %>" class="aspect-square rounded-lg overflow-hidden border <%= i === 0 ? 'border-ink' : 'border-neutral-200' %>" aria-label="Show image <%= i + 1 %>"><img src="<%= src %>" alt="<%= product.imageAlt %> - image <%= i + 1 %>" class="w-full h-full object-cover" loading="lazy" decoding="async" width="160" height="160"></button>
      <% }) %>
    </div>
    <% } %>
  </div>

  <!-- Buy box -->
  <div>
    <% if (product.badge) { %><p class="inline-block bg-gold-soft text-gold-dark text-xs font-semibold px-3 py-1 rounded-full mb-3"><%= product.badge %></p><% } %>
    <h1 class="text-4xl md:text-5xl font-semibold leading-tight"><%= product.name %></h1>
    <% if (reviews.length) { %><p class="mt-3 flex items-center gap-2 text-sm"><%- include('partials/stars', { n: Math.round(reviews.reduce((s, r) => s + r.rating, 0) / reviews.length) }) %> <span class="text-neutral-600"><%= reviews.length %> review<%= reviews.length > 1 ? 's' : '' %></span></p><% } %>

    <p class="mt-5 flex items-baseline flex-wrap gap-3">
      <span data-price class="text-3xl font-semibold"><%= money(initial.price) %></span>
      <span data-mrp class="text-lg text-neutral-500 line-through"><%= money(initial.mrp) %></span>
      <span class="bg-gold-dark text-white text-xs font-semibold px-2.5 py-1 rounded-full">Save <%= product.discount %>%</span>
    </p>
    <p class="text-xs text-neutral-500 mt-1">Inclusive of all taxes. <%= !offers.shippingFee ? 'Free shipping.' : offers.freeShipThreshold ? 'Free delivery on orders above ' + money(offers.freeShipThreshold) + '.' : 'Delivery ' + money(offers.shippingFee) + '.' %></p>
    <% if (offerTiers.length && !product.isBundle) { %><p class="mt-3 text-sm font-semibold text-gold-dark"><%= offerTiers.map((t) => 'Buy ' + t.qty + ', save ' + money(t.off)).join(' \u00B7 ') %></p><% } %>
    <% if (initial.isBundle) { %>
    <div class="mt-4 border border-gold-soft bg-paper rounded-xl p-4 text-sm">
      <p class="font-semibold">This combo includes</p>
      <ul class="mt-2 space-y-1"><% initial.components.forEach((c) => { %><li class="flex justify-between gap-3"><span><%= c.name %><%= c.label ? ' (' + c.label + ')' : '' %> &times; <%= c.qty %></span><span class="text-neutral-500"><%= money(c.price * c.qty) %></span></li><% }) %></ul>
      <% if (initial.componentsValue > initial.price) { %><p class="mt-2 text-green-800 font-semibold">Worth <%= money(initial.componentsValue) %> separately &mdash; you save <%= money(initial.componentsValue - initial.price) %></p><% } %>
    </div>
    <% } %>
    <% if (offers.prepaidDiscount) { %><p class="mt-3 inline-flex items-center gap-2 bg-green-50 border border-green-200 text-green-800 text-sm font-semibold px-3 py-1.5 rounded-lg">Pay online &amp; save <%= money(offers.prepaidDiscount) %> extra</p><% } %>

    <form method="post" action="/cart/add" class="mt-6" data-buy-form>
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input type="hidden" name="slug" value="<%= product.slug %>">
      <input type="hidden" name="sku" value="<%= initial.sku %>" data-sku>

      <fieldset>
        <legend class="label"><%= product.variants.length > 1 ? 'Choose a size' : 'Size' %></legend>
        <div class="flex flex-wrap gap-2">
          <% product.variants.forEach((v) => { %>
          <label class="cursor-pointer">
            <input type="radio" name="variant" value="<%= v.sku %>" class="peer sr-only" <%= v.sku === initial.sku ? 'checked' : '' %>>
            <span class="block px-4 py-2.5 text-sm rounded-lg border border-neutral-300 peer-checked:border-ink peer-checked:bg-ink peer-checked:text-white peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-gold hover:border-ink <%= v.stock <= 0 ? 'opacity-50 line-through' : '' %>"><%= v.label %></span>
          </label>
          <% }) %>
        </div>
      </fieldset>

      <p data-stock class="mt-4 text-sm font-medium <%= initial.stock <= 0 ? 'text-red-600' : initial.stock <= 5 ? 'text-amber-600' : 'text-green-700' %>"><%= initial.stock <= 0 ? 'Out of stock' : initial.stock <= 5 ? 'Only ' + initial.stock + ' left' : 'In stock' %></p>
      <div class="mt-4">
        <label class="label" for="qty">Quantity</label>
        <div class="inline-flex items-center border border-neutral-300 rounded-full">
          <button type="button" data-qty-dec class="w-11 h-11 text-xl" aria-label="Decrease quantity">&minus;</button>
          <input id="qty" name="qty" type="number" min="1" max="10" value="1" inputmode="numeric" class="w-12 text-center bg-transparent outline-none [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none" data-qty>
          <button type="button" data-qty-inc class="w-11 h-11 text-xl" aria-label="Increase quantity">+</button>
        </div>
      </div>

      <div class="mt-7 grid sm:grid-cols-2 gap-3">
        <button type="submit" data-add-to-cart class="btn-outline py-4 text-base" <%= initial.stock <= 0 ? 'disabled' : '' %>>Add to cart</button>
        <button type="submit" formaction="/cart/buy-now" data-buy-now class="btn-dark py-4 text-base" <%= initial.stock <= 0 ? 'disabled' : '' %>>Buy now</button>
      </div>
    </form>

    <!-- Delivery check -->
    <div class="mt-8 border border-neutral-200 rounded-xl p-5">
      <p class="font-semibold text-sm">Check delivery</p>
      <form data-pincode class="mt-3 flex gap-2">
        <label class="sr-only" for="pin">Pincode</label>
        <input id="pin" inputmode="numeric" maxlength="6" placeholder="Enter 6-digit pincode" class="field">
        <button class="btn-dark px-6">Check</button>
      </form>
      <p data-pin-result class="mt-3 text-sm hidden"></p>
    </div>

    <ul class="mt-6 grid grid-cols-2 gap-3 text-sm text-neutral-700">
      <li class="flex gap-2"><span class="text-gold">&#10003;</span> BPA free, food grade</li>
      <% if (offers.codEnabled) { %><li class="flex gap-2"><span class="text-gold">&#10003;</span> Cash on delivery available</li><% } %>
      <% if (offers.partialEnabled) { %><li class="flex gap-2"><span class="text-gold">&#10003;</span> Partial COD: pay <%= offers.partialText %> now, rest on delivery</li><% } %>
      <% if (offers.prepaidDiscount) { %><li class="flex gap-2"><span class="text-gold">&#10003;</span> Extra <%= money(offers.prepaidDiscount) %> off on online payment</li><% } %>
      <li class="flex gap-2"><span class="text-gold">&#10003;</span> 7-day damage replacement</li>
    </ul>
  </div>
</section>

<% if (addons.length) { const mainV = initial; const fbtTotal = mainV.price + addons.reduce((s, a) => s + defaultVariant(a).price, 0); %>
<section class="container-x pt-6" aria-labelledby="fbt-h">
  <form method="post" action="/cart/add-many" class="border border-neutral-200 rounded-2xl p-5" data-fbt>
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <h2 id="fbt-h" class="text-2xl font-semibold">Frequently bought together</h2>
    <div class="mt-4 grid sm:grid-cols-[1fr_auto] gap-6 items-center">
      <ul class="space-y-3">
        <li><label class="flex items-center gap-3 text-sm"><input type="checkbox" name="add" value="<%= product.slug %>:<%= mainV.sku %>" data-price="<%= mainV.price %>" data-fbt-main checked class="accent-[#b07a2a]">
          <img src="<%= product.image %>" alt="" class="w-12 h-12 rounded-lg object-cover bg-paper" loading="lazy"><span class="flex-1"><b>This item:</b> <%= product.name %></span><b><%= money(mainV.price) %></b></label></li>
        <% addons.forEach((a) => { const v = defaultVariant(a); %>
        <li><label class="flex items-center gap-3 text-sm"><input type="checkbox" name="add" value="<%= a.slug %>:<%= v.sku %>" data-price="<%= v.price %>" checked class="accent-[#b07a2a]">
          <img src="<%= a.image %>" alt="" class="w-12 h-12 rounded-lg object-cover bg-paper" loading="lazy"><a href="/products/<%= a.slug %>" class="flex-1 hover:underline"><%= a.name %><%= a.multi ? ' (' + v.label + ')' : '' %></a><b><%= money(v.price) %></b></label></li>
        <% }) %>
      </ul>
      <div class="text-center sm:text-right">
        <p class="text-sm text-neutral-600">Total for selected</p>
        <p class="text-2xl font-semibold" data-fbt-total><%= money(fbtTotal) %></p>
        <button class="btn-dark mt-3 px-6 py-3" data-fbt-btn>Add selected to cart</button>
      </div>
    </div>
  </form>
</section>
<% } %>

<!-- Details -->
<section class="container-x pt-6 grid lg:grid-cols-2 gap-10">
  <div>
    <h2 class="text-2xl font-semibold">About this product</h2>
    <p class="mt-3 text-neutral-700 leading-relaxed max-w-prose"><%= product.description %></p>
    <% if (product.features.length) { %>
      <ul class="mt-5 space-y-2 text-neutral-700">
        <% product.features.forEach((f) => { %><li class="flex gap-2"><span class="text-gold">&#8226;</span><%= f %></li><% }) %>
      </ul>
    <% } %>
  </div>
  <div>
    <h2 class="text-2xl font-semibold">Specifications</h2>
    <div class="mt-3 overflow-x-auto">
      <table class="w-full text-sm border border-neutral-200 rounded-lg">
        <thead class="bg-paper text-left"><tr><th class="p-3 font-semibold">Size</th><th class="p-3 font-semibold">SKU</th><th class="p-3 font-semibold">Price</th></tr></thead>
        <tbody>
          <% product.variants.forEach((v) => { %><tr class="border-t border-neutral-200"><td class="p-3"><%= v.label %></td><td class="p-3 text-neutral-600"><%= v.sku %></td><td class="p-3"><%= money(v.price) %></td></tr><% }) %>
        </tbody>
      </table>
    </div>
    <dl class="mt-4 grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 text-sm">
      <dt class="text-neutral-500">Category</dt><dd><%= product.categoryName %></dd>
    </dl>
  </div>
</section>

<!-- Reviews: only real reviews from customers who received their order (review link sent on WhatsApp after delivery, approved in admin) -->
<section class="container-x pt-14" id="reviews" aria-labelledby="reviews-h">
  <h2 id="reviews-h" class="text-2xl font-semibold">Customer reviews</h2>
  <% if (reviews.length) { const avgR = reviews.reduce((s, r) => s + r.rating, 0) / reviews.length; %>
  <p class="mt-2 flex items-center gap-2 text-sm"><%- include('partials/stars', { n: Math.round(avgR) }) %> <b><%= avgR.toFixed(1) %> out of 5</b> <span class="text-neutral-600">from <%= reviews.length %> review<%= reviews.length > 1 ? 's' : '' %></span></p>
  <div class="mt-5 grid md:grid-cols-2 gap-5">
    <% reviews.forEach((r) => { %>
      <div class="border border-neutral-200 rounded-xl p-5"><%- include('partials/stars', { n: r.rating }) %><% if (r.title) { %><p class="font-display text-lg mt-2"><%= r.title %></p><% } %><% if (r.body) { %><p class="text-sm text-neutral-700 mt-1"><%= r.body %></p><% } %>
        <% if (r.photoUrl) { %><img src="<%= r.photoUrl %>" alt="Photo from <%= r.customer_name %>" loading="lazy" decoding="async" class="mt-3 w-28 h-28 rounded-lg object-cover"><% } %>
        <p class="text-sm mt-3 font-semibold"><%= String(r.customer_name || 'Customer').split(' ')[0] %><% if (r.city) { %> <span class="font-normal text-neutral-500">from <%= r.city %></span><% } %><% if (r.order_id) { %> <span class="ml-1 text-xs font-medium text-green-700 bg-green-50 rounded-full px-2 py-0.5">&#10003; Verified buyer</span><% } %></p></div>
    <% }) %>
  </div>
  <% } else { %>
  <p class="mt-3 text-sm text-neutral-600">No reviews yet. Only customers who have received this product can review it &mdash; we send the review link on WhatsApp after delivery.</p>
  <% } %>
</section>

<%- include('partials/ugc', { items: testimonials, heading: 'See it in real homes', sub: 'Customer videos' }) %>

<% if (related.length) { %>
<section class="container-x pt-16">
  <h2 class="text-2xl md:text-3xl font-semibold mb-6">More from <%= product.categoryName.toLowerCase() %></h2>
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-4 gap-y-10">
    <% related.forEach((p) => { %><%- include('partials/product-card', { p }) %><% }) %>
  </div>
</section>
<% } %>

<%- include('partials/footer') %>
