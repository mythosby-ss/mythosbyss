<%- include('partials/header') %>
<div class="container-x py-10">
  <h1 class="text-4xl font-semibold">Your cart</h1>
  <% if (!cart.items.length) { %>
    <div class="text-center py-20">
      <p class="font-display text-2xl">Your cart is empty</p>
      <p class="mt-2 text-neutral-600">Add a bottle, lunch box or casserole to get started.</p>
      <a href="/products" class="btn-dark mt-6">Browse products</a>
    </div>
  <% } else { %>
  <div class="mt-8 grid lg:grid-cols-[1fr_380px] gap-10">
    <ul class="divide-y divide-neutral-200 border-y border-neutral-200">
      <% cart.items.forEach((i) => { %>
      <li class="py-5 flex gap-4">
        <a href="/products/<%= i.slug %>" class="w-24 h-24 sm:w-28 sm:h-28 shrink-0 rounded-lg overflow-hidden bg-paper"><img src="<%= i.product.image %>" alt="<%= i.product.name %>" class="w-full h-full object-cover"></a>
        <div class="flex-1 min-w-0">
          <a href="/products/<%= i.slug %>?v=<%= i.sku %>" class="font-display text-lg hover:text-gold-dark"><%= i.product.name %></a>
          <p class="text-sm text-neutral-500"><%= i.variant.label %> &middot; <%= i.sku %></p>
          <p class="mt-1 text-sm"><%= money(i.unit) %> <span class="line-through text-neutral-400"><%= money(i.mrp) %></span></p>
          <div class="mt-3 flex items-center gap-4 flex-wrap">
            <form method="post" action="/cart/update" class="flex items-center gap-2">
              <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="sku" value="<%= i.sku %>">
              <label class="sr-only" for="q-<%= i.sku %>">Quantity</label>
              <input id="q-<%= i.sku %>" type="number" name="qty" min="1" max="<%= maxQty %>" value="<%= i.qty %>" class="w-16 border border-neutral-300 rounded-lg px-2 py-2 text-center text-sm">
              <button class="text-sm underline underline-offset-4 hover:text-gold-dark">Update</button>
            </form>
            <form method="post" action="/cart/remove"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="sku" value="<%= i.sku %>"><button class="text-sm text-neutral-500 underline underline-offset-4 hover:text-red-600">Remove</button></form>
          </div>
        </div>
        <p class="font-semibold"><%= money(i.total) %></p>
      </li>
      <% }) %>
    </ul>
    <aside class="bg-paper rounded-2xl p-6 h-fit lg:sticky lg:top-28">
      <h2 class="text-xl font-semibold">Order summary</h2>
      <dl class="mt-4 space-y-2 text-sm">
        <div class="flex justify-between"><dt>Items (<%= cart.count %>)</dt><dd><%= money(cart.mrpTotal) %></dd></div>
        <div class="flex justify-between text-green-700"><dt>Discount</dt><dd>&minus; <%= money(cart.savings) %></dd></div>
        <div class="flex justify-between"><dt>Shipping</dt><dd><%= cart.shipping ? money(cart.shipping) : 'Free' %></dd></div>
        <div class="flex justify-between border-t border-neutral-300 pt-3 text-base font-semibold"><dt>Total</dt><dd><%= money(cart.subtotal + cart.shipping) %></dd></div>
      </dl>
      <a href="/checkout" class="btn-dark w-full mt-6 py-4 text-base">Proceed to checkout</a>
      <a href="/products" class="block text-center text-sm mt-4 underline underline-offset-4">Continue shopping</a>
    </aside>
  </div>
  <% } %>
</div>
<%- include('partials/footer') %>
