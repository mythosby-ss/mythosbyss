<%- include('partials/header') %>
<div class="container-x py-12 max-w-2xl">
  <h1 class="text-4xl font-semibold">How was your order?</h1>
  <p class="mt-2 text-neutral-600">Thank you for shopping with MythosBySS, <%= order.name.split(' ')[0] %>. Your review helps other families choose well.</p>
  <% if (thanks) { %><p class="mt-6 bg-green-50 border border-green-200 text-green-800 rounded-lg p-4">Thank you! Your review will appear after a quick check.</p><% } %>
  <% if (!items.length && !thanks) { %><p class="mt-6 text-neutral-600">You have already reviewed everything in this order. Thank you!</p><% } %>
  <% if (items.length) { %>
  <form method="post" action="/review/<%= order.review_token %>" class="mt-8 space-y-8">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <% items.forEach((it) => { %>
    <fieldset class="border border-neutral-200 rounded-xl p-5">
      <legend class="px-2 font-display text-lg"><%= it.product_name %></legend>
      <div class="flex gap-2 flex-row-reverse justify-end" role="radiogroup" aria-label="Rating for <%= it.product_name %>">
        <% for (let n = 5; n >= 1; n--) { %><input type="radio" class="peer sr-only" id="r-<%= it.product_slug %>-<%= n %>" name="rating_<%= it.product_slug %>" value="<%= n %>"><label for="r-<%= it.product_slug %>-<%= n %>" class="cursor-pointer text-3xl text-neutral-300 peer-checked:text-gold hover:text-gold [&:hover~label]:text-gold" title="<%= n %> star<%= n > 1 ? 's' : '' %>">&#9733;</label><% } %>
      </div>
      <div class="mt-4"><label class="label" for="t-<%= it.product_slug %>">Headline</label><input class="field" id="t-<%= it.product_slug %>" name="title_<%= it.product_slug %>" maxlength="100"></div>
      <div class="mt-3"><label class="label" for="b-<%= it.product_slug %>">Your review</label><textarea class="field" id="b-<%= it.product_slug %>" name="body_<%= it.product_slug %>" rows="3" maxlength="1000"></textarea></div>
    </fieldset>
    <% }) %>
    <button class="btn-dark px-8 py-4">Submit review</button>
  </form>
  <% } %>
</div>
<%- include('partials/footer') %>
