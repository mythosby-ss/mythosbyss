<%- include('partials/header') %>

<!-- Hero carousel -->

<!-- Hero carousel -->
<section
  aria-roledescription="carousel"
  aria-label="Featured collections"
  data-carousel
  class="relative overflow-hidden"
>
  <% const themes = {
    lilac: 'bg-gradient-to-br from-lilac-soft via-white to-lilac-soft text-lilac-deep',
    gold: 'bg-gradient-to-br from-gold-soft via-white to-gold-soft text-gold-dark',
    ink: 'bg-gradient-to-br from-neutral-900 via-neutral-800 to-neutral-900 text-white'
  }; %>

  <% slides.forEach((s, i) => { %>

    <div
      data-slide
      class="<%= i === 0 ? '' : 'hidden' %> <%= themes[s.theme] %>"
    >

      <div
        class="
          container-x
          grid
          grid-cols-1
          md:grid-cols-2
          items-center
          gap-8
          md:gap-12
          py-12
          md:py-16
          min-h-[500px]
          md:min-h-[520px]
        "
      >

        <!-- LEFT: Banner Content -->
        <div class="order-2 md:order-1">

          <%# only the first slide is the page's H1; the others are H2 (one H1 per page) %>
          <<%= i === 0 ? 'h1' : 'h2' %>
            class="
              text-4xl
              sm:text-5xl
              md:text-6xl
              lg:text-7xl
              font-semibold
              leading-[1.03]
              tracking-tight
            "
          >
            <%= s.title %>
          </<%= i === 0 ? 'h1' : 'h2' %>>

          <p
            class="
              mt-5
              text-base
              md:text-lg
              max-w-md
              leading-relaxed
              opacity-90
            "
          >
            <%= s.text %>
          </p>

          <a
            href="<%= s.href %>"
            class="
              <%= s.theme === 'ink'
                ? 'bg-white text-ink hover:bg-gold-soft'
                : 'bg-ink text-white hover:bg-gold-dark'
              %>
              btn
              mt-8
              inline-flex
              items-center
              justify-center
              px-8
              py-4
              text-base
              rounded-full
              transition-all
              duration-300
              hover:-translate-y-1
            "
          >
            <%= s.cta %>
          </a>

        </div>

        <!-- RIGHT: Slide image -->
        <div
          class="
            order-1
            md:order-2
            w-full
            flex
            items-center
            justify-center
          "
        >

          <div
            class="
              w-full
              max-w-[520px]
              h-[300px]
              sm:h-[360px]
              md:h-[400px]
              lg:h-[440px]
              flex
              items-center
              justify-center
              overflow-hidden
              rounded-[2rem]
            "
          >

            <picture class="contents"><% const sw = webp(s.image); if (sw) { %><source srcset="<%= sw %>" type="image/webp"><% } %>
            <img
              src="<%= s.image || '/images/placeholder.svg' %>"
              alt="<%= s.title %>"
              class="
                w-full
                h-full
                object-contain
                rounded-[2rem]
              "
              loading="<%= i === 0 ? 'eager' : 'lazy' %>"
              <%= i === 0 ? 'fetchpriority=high' : '' %> decoding="async"
            ></picture>

          </div>

        </div>

      </div>

    </div>

  <% }) %>

  <!-- Previous Slide -->
  <button
    type="button"
    data-prev
    class="
      absolute
      left-0
      top-1/2
      -translate-y-1/2
      z-10
      bg-white/90
      border
      border-neutral-300
      w-10
      h-12
      flex
      items-center
      justify-center
      hover:bg-white
      transition
    "
    aria-label="Previous slide"
  >
    <svg
      class="w-5 h-5"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      viewBox="0 0 24 24"
    >
      <path d="m15 5-7 7 7 7"/>
    </svg>
  </button>

  <!-- Next Slide -->
  <button
    type="button"
    data-next
    class="
      absolute
      right-0
      top-1/2
      -translate-y-1/2
      z-10
      bg-white/90
      border
      border-neutral-300
      w-10
      h-12
      flex
      items-center
      justify-center
      hover:bg-white
      transition
    "
    aria-label="Next slide"
  >
    <svg
      class="w-5 h-5"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      viewBox="0 0 24 24"
    >
      <path d="m9 5 7 7-7 7"/>
    </svg>
  </button>

</section>

<!-- Trust strip -->
<section class="border-b border-neutral-200">
  <div class="container-x grid grid-cols-2 md:grid-cols-4 gap-4 py-6 text-sm">
    <p><strong class="block">BPA free</strong><span class="text-neutral-600">Food-grade materials</span></p>
    <p><strong class="block">Free shipping</strong><span class="text-neutral-600">On every order</span></p>
    <p><strong class="block">3 ways to pay</strong><span class="text-neutral-600">Online, COD or partial COD</span></p>
    <p><strong class="block">Save min 50%</strong><span class="text-neutral-600">Against listed MRP</span></p>
  </div>
</section>

<!-- One product from each category -->
<section class="container-x pt-16">
  <div class="flex items-end justify-between gap-4 mb-8">
    <h2 class="text-3xl md:text-4xl font-semibold">Shop by category</h2>
    <a href="/products" class="text-sm font-semibold underline underline-offset-4 hover:text-gold-dark">View all products</a>
  </div>
  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-4 gap-y-10">
    <% featured.forEach((p) => { %>
      <div>
        <%- include('partials/product-card', { p }) %>
        <a href="/collections/<%= p.category %>" class="mt-2 inline-block text-xs text-gold-dark font-semibold hover:underline">More <%= p.categoryName.toLowerCase() %> products</a>
      </div>
    <% }) %>
  </div>
</section>

<% if (newArrivals.length) { %>
<section class="container-x pt-20">
  <div class="flex items-end justify-between gap-4 mb-8">
    <h2 class="text-3xl md:text-4xl font-semibold">Just landed</h2>
    <a href="/new-arrivals" class="text-sm font-semibold underline underline-offset-4 hover:text-gold-dark">See new arrivals</a>
  </div>
  <% if (typeof deals !== 'undefined' && deals) { %><%- include('partials/deals-banner', { deals }) %><% } %>
  <div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-6 gap-x-4 gap-y-10">
    <% newArrivals.forEach((p) => { %><%- include('partials/product-card', { p }) %><% }) %>
  </div>
</section>
<% } %>

<!-- Customer reviews (real, approved reviews only; hidden until there are some) -->
<% if (reviews.length) { %>
<section class="mt-24 bg-paper py-16" aria-labelledby="reviews-h">
  <div class="container-x">
    <h2 id="reviews-h" class="text-3xl md:text-4xl font-semibold">What customers say</h2>
    <p class="mt-2 text-neutral-600">Real kitchens, lunch bags and shop counters.</p>
    <div class="mt-10 grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% reviews.forEach((r) => { %>
      <figure class="bg-white rounded-2xl overflow-hidden border border-neutral-200 flex flex-col">
        <% if (r.photoUrl) { %>
          <div class="aspect-[4/3] bg-neutral-100"><img src="<%= r.photoUrl %>" alt="Photo shared by <%= r.customer_name %>" loading="lazy" class="w-full h-full object-cover"></div>
        <% } %>
        <figcaption class="p-5 flex-1 flex flex-col">
          <%- include('partials/stars', { n: r.rating }) %>
          <p class="font-display text-lg mt-2"><%= r.title %></p>
          <blockquote class="mt-2 text-sm text-neutral-700 leading-relaxed flex-1"><%= r.body %></blockquote>
          <p class="mt-4 text-sm"><span class="font-semibold"><%= r.customer_name %></span> <span class="text-neutral-500">from <%= r.city %></span></p>
          <% if (r.productObj) { %><a class="text-xs text-gold-dark font-semibold mt-1 hover:underline" href="/products/<%= r.product_slug %>">Bought: <%= r.productObj.name %></a><% } %>
        </figcaption>
      </figure>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<%- include('partials/ugc', { items: testimonials, heading: 'Real customers, real kitchens', sub: 'Customer videos and photos shared with reviews.' }) %>

<%- include('partials/footer') %>
