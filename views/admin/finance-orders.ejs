<%- include('partials/top') %>
<div class="grid grid-cols-2 lg:grid-cols-4 xl:grid-cols-7 gap-3">
  <% [['Orders', totals.orders], ['Order value', money(totals.value)], ['Discounts', money(totals.discount)], ['Shipping charged', money(totals.shipping)], ['Prepaid received', money(totals.online)], ['COD collected', money(totals.cod)], ['Refunds', money(totals.refunds)]].forEach(([l, v]) => { %><div class="kpi"><b class="!text-lg"><%= v %></b><span><%= l %></span></div><% }) %>
</div>
<section class="a-card">
  <div class="p-4"><form method="get" class="flex flex-wrap items-end gap-3">
    <div><label class="a-lbl">From</label><input class="a-in" type="date" name="from" value="<%= r.from %>"></div><div><label class="a-lbl">To</label><input class="a-in" type="date" name="to" value="<%= r.to %>"></div>
    <div><label class="a-lbl">Status</label><select class="a-in" name="status"><option value="">All</option><% ['awaiting_payment','confirmed','packed','shipped','out_for_delivery','delivered','cancelled','rto'].forEach((s) => { %><option value="<%= s %>" <%= f.status === s ? 'selected' : '' %>><%= s.replace(/_/g,' ') %></option><% }) %></select></div>
    <div><label class="a-lbl">Payment</label><select class="a-in" name="method"><option value="">All</option><% ['cod','prepaid','partial_cod'].forEach((s) => { %><option value="<%= s %>" <%= f.method === s ? 'selected' : '' %>><%= s.replace('_',' ') %></option><% }) %></select></div>
    <div class="min-w-[180px]"><label class="a-lbl">Search</label><input class="a-in" name="q" value="<%= f.q || '' %>" placeholder="Order, phone, name"></div>
    <button class="a-btn">Apply</button>
    <a class="a-btn-o" href="?<%= new URLSearchParams({ ...f, format: 'csv' }).toString() %>">Download CSV</a>
  </form></div>
  <div class="overflow-x-auto"><table class="a-table min-w-[1100px]"><thead><tr><th>Order</th><th>Date</th><th>Customer</th><th>Items</th><th>Mode</th><th>Order value</th><th>Online paid</th><th>COD collected</th><th>Refund</th><th>Courier cost</th><th>Status</th></tr></thead><tbody>
    <% rows.forEach((o) => { %><tr><td><a class="text-adm-blue hover:underline" href="/admin/orders/<%= o.id %>"><%= o.id %></a></td><td><%= d(o.created_at) %></td><td><%= o.name %><br><span class="text-xs text-neutral-500"><%= o.phone %></span></td><td class="max-w-[220px] text-xs"><%= o.items %></td><td><%= o.payment_method.replace('_',' ') %><br><%- pill(o.payment_status) %></td><td><b><%= money(o.total) %></b><% if (o.discount) { %><br><span class="text-xs text-green-700">-<%= money(o.discount) %> disc.</span><% } %></td><td><%= money(o.onlinePaid) %></td><td><%= money(o.codCollected) %><% if (o.codCollected && !o.cod_settlement_id) { %><br><span class="text-xs text-amber-600">unsettled</span><% } %></td><td class="text-red-600"><%= o.refunded ? '-' + money(o.refunded) : '' %></td><td><%= money(o.courier_charge) %></td><td><%- pill(o.status) %></td></tr><% }) %>
    <% if (!rows.length) { %><tr><td colspan="11" class="text-center text-neutral-500 py-8">No orders match.</td></tr><% } %></tbody></table></div>
</section>
<%- include('partials/bottom') %>
