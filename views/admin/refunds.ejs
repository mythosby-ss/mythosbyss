<%- include('partials/top') %>
<% if (owed.length) { %><section class="a-card border-amber-300"><h2 class="a-h p-5 pb-3 text-amber-700">Refunds to process (<%= owed.length %>)</h2><p class="px-5 text-sm text-neutral-600">Cancelled orders where the customer paid online and has not been fully refunded.</p>
  <table class="a-table mt-3"><thead><tr><th>Order</th><th>Customer</th><th>Paid online</th><th>Refunded</th><th></th></tr></thead><tbody><% owed.forEach((o) => { %><tr><td><%= o.id %></td><td><%= o.name %></td><td><%= money(o.pay_now) %></td><td><%= money(o.refunded) %></td><td><a class="a-btn" href="/admin/orders/<%= o.id %>">Refund</a></td></tr><% }) %></tbody></table></section><% } %>
<section class="a-card overflow-x-auto"><h2 class="a-h p-5 pb-3">Refund history</h2><table class="a-table min-w-[700px]"><thead><tr><th>Date</th><th>Order</th><th>Customer</th><th>Amount</th><th>Method</th><th>Reason</th><th>Razorpay ID</th></tr></thead><tbody>
  <% list.forEach((r) => { %><tr><td><%= dt(r.created_at) %></td><td><a class="text-adm-blue" href="/admin/orders/<%= r.order_id %>"><%= r.order_id %></a></td><td><%= r.name %></td><td class="text-red-600"><%= money(r.amount) %></td><td><%= r.method %></td><td><%= r.reason %></td><td class="text-xs"><%= r.razorpay_refund_id || '' %></td></tr><% }) %><% if (!list.length) { %><tr><td colspan="7" class="text-center text-neutral-500 py-6">No refunds yet.</td></tr><% } %></tbody></table></section>
<section class="a-card overflow-x-auto"><h2 class="a-h p-5 pb-3">Cancellations &amp; RTO</h2><table class="a-table min-w-[700px]"><thead><tr><th>Order</th><th>Customer</th><th>Value</th><th>Mode</th><th>Status</th><th>Reason</th><th>When</th></tr></thead><tbody>
  <% cancelled.forEach((o) => { %><tr><td><a class="text-adm-blue" href="/admin/orders/<%= o.id %>"><%= o.id %></a></td><td><%= o.name %></td><td><%= money(o.total) %></td><td><%= o.payment_method.replace('_',' ') %></td><td><%- pill(o.status) %></td><td><%= o.cancel_reason || '' %></td><td><%= d(o.cancelled_at) %></td></tr><% }) %></tbody></table></section>
<%- include('partials/bottom') %>
