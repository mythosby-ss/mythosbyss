<%- include('partials/top') %>
<form method="post" action="/admin/settings" class="a-card p-5 max-w-3xl space-y-4">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <h2 class="a-h">Store settings</h2>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div class="md:col-span-2"><label class="a-lbl" for="announcement">Announcement bar text</label><input class="a-in" id="announcement" name="announcement" value="<%= s.announcement %>"></div>
    <div><label class="a-lbl">Store name</label><input class="a-in" name="store_name" value="<%= s.store_name %>"></div>
    <div><label class="a-lbl">Support email</label><input class="a-in" type="email" name="support_email" value="<%= s.support_email %>"></div>
    <div><label class="a-lbl">Shipping fee charged to customer (INR)</label><input class="a-in" type="number" min="0" name="shipping_fee" value="<%= s.shipping_fee %>"></div>
    <div class="md:col-span-2 text-sm text-neutral-500">COD fee, partial COD advance and prepaid discount are under <a class="underline" href="/admin/settings/cod">Settings &gt; COD &amp; RTO rules</a>.</div>
    <div><label class="a-lbl">GST % (for tax report)</label><input class="a-in" type="number" step="0.1" name="gst_percent" value="<%= s.gst_percent %>"></div>
    <div><label class="a-lbl">Your state (GST CGST/SGST vs IGST)</label><input class="a-in" name="home_state" value="<%= s.home_state || 'Uttar Pradesh' %>"></div>
    <div><label class="a-lbl">Payment gateway fee % (profit estimate)</label><input class="a-in" type="number" step="0.1" name="pg_fee_percent" value="<%= s.pg_fee_percent %>"></div>
    <div><label class="a-lbl">Review request: hours after delivery</label><input class="a-in" type="number" min="0" name="review_delay_hours" value="<%= s.review_delay_hours %>"></div>
  </div>
  <h2 class="a-h pt-2">New arrivals ("Just landed")</h2>
  <p class="text-sm text-neutral-500 -mt-2">Shows products marked <b>New</b> or added in the last few days. If fewer are found, it is topped up with your best sellers. If nothing new was added in that time, best sellers are shown instead.</p>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div><label class="a-lbl" for="na_min">Always show at least (products)</label><input class="a-in" id="na_min" type="number" min="1" max="24" name="new_arrivals_min" value="<%= s.new_arrivals_min %>"></div>
    <div><label class="a-lbl" for="na_max">Show at most (products)</label><input class="a-in" id="na_max" type="number" min="1" max="48" name="new_arrivals_max" value="<%= s.new_arrivals_max %>"></div>
    <div><label class="a-lbl" for="na_days">Count a product as new for (days)</label><input class="a-in" id="na_days" type="number" min="7" max="365" name="new_arrivals_days" value="<%= s.new_arrivals_days %>"></div>
    <div><label class="a-lbl" for="na_banner">Banner text (empty = no banner)</label><input class="a-in" id="na_banner" name="new_arrivals_banner" value="<%= s.new_arrivals_banner %>" placeholder="Hot Deals"></div>
    <div><label class="a-lbl" for="na_sub">Banner line under it</label><input class="a-in" id="na_sub" name="new_arrivals_banner_sub" value="<%= s.new_arrivals_banner_sub %>"></div>
  </div>
  <button class="a-btn px-6 py-3">Save settings</button>
</form>
<%- include('partials/bottom') %>
