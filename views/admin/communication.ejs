<%- include('partials/top') %>
<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
  <section class="a-card p-5"><h2 class="a-h">WhatsApp status</h2>
    <p class="mt-2 text-sm"><%- configured ? pill('Connected (Cloud API credentials found)', 'green') : pill('Not configured - messages are only logged', 'amber') %></p>
    <form method="post" action="/admin/communication/toggle" class="mt-4 flex items-center gap-3"><input type="hidden" name="_csrf" value="<%= csrf %>"><label class="text-sm flex items-center gap-2"><input type="checkbox" name="enabled" value="1" <%= enabled ? 'checked' : '' %>> Send order notifications</label><button class="a-btn-o !py-1">Save</button></form>
    <p class="text-xs text-neutral-500 mt-3">Login OTPs are always sent. Set WHATSAPP_TOKEN and WHATSAPP_PHONE_ID in .env.</p></section>
  <section class="a-card p-5"><h2 class="a-h">Message health</h2><ul class="mt-2 text-sm space-y-1"><% stats.forEach((s) => { %><li class="flex justify-between"><span><%- pill(s.status) %></span><b><%= s.n %></b></li><% }) %><% if (!stats.length) { %><li class="text-neutral-500">No messages yet.</li><% } %></ul>
    <form method="post" action="/admin/communication/run-queue" class="mt-3"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="a-btn-o w-full">Process scheduled messages now</button></form></section>
  <section class="a-card p-5"><h2 class="a-h">Send a test</h2><form method="post" action="/admin/communication/test" class="mt-3 space-y-2"><input type="hidden" name="_csrf" value="<%= csrf %>"><input class="a-in" name="phone" inputmode="numeric" maxlength="10" placeholder="10-digit WhatsApp number"><button class="a-btn w-full">Send "delivered" template</button></form></section>
</div>
<section class="a-card overflow-x-auto"><h2 class="a-h p-5 pb-1">Message templates</h2><p class="px-5 pb-3 text-sm text-neutral-600">Create these in Meta WhatsApp Manager with the exact names and variable order (text is in <code>docs/WHATSAPP_TEMPLATES.md</code>). Only approved templates can be sent outside the 24-hour window.</p>
  <table class="a-table min-w-[760px]"><thead><tr><th>Template name</th><th>Category</th><th>Purpose</th><th>Variables</th></tr></thead><tbody><% templates.forEach((t) => { %><tr><td><b><%= t.name %></b></td><td><%- pill(t.category, t.category === 'MARKETING' ? 'amber' : 'blue') %></td><td><%= t.purpose %></td><td class="text-xs"><%= t.params %></td></tr><% }) %></tbody></table></section>
<section class="a-card overflow-x-auto"><div class="p-5 pb-3 flex flex-wrap justify-between gap-3"><h2 class="a-h">Notification log</h2>
  <form method="get" class="flex gap-2"><select class="a-in" name="status" data-autosubmit><option value="">All statuses</option><% ['sent','delivered','read','failed','simulated','scheduled'].forEach((s) => { %><option <%= f.status === s ? 'selected' : '' %>><%= s %></option><% }) %></select><select class="a-in" name="template" data-autosubmit><option value="">All templates</option><% templates.slice(1).forEach((t) => { %><option value="<%= t.name %>" <%= f.template === t.name ? 'selected' : '' %>><%= t.name %></option><% }) %></select></form></div>
  <table class="a-table min-w-[760px]"><thead><tr><th>When</th><th>Order</th><th>Phone</th><th>Template</th><th>Status</th><th>Error</th></tr></thead><tbody><% logs.forEach((l) => { %><tr><td><%= dt(l.created_at) %></td><td><% if (l.order_id) { %><a class="text-adm-blue" href="/admin/orders/<%= l.order_id %>"><%= l.order_id %></a><% } %></td><td><%= l.customer_phone %></td><td><%= l.template %></td><td><%- pill(l.status) %></td><td class="text-red-600 text-xs"><%= l.error || '' %></td></tr><% }) %></tbody></table></section>
<%- include('partials/bottom') %>
