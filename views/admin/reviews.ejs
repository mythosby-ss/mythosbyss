<%- include('partials/top') %>
<div class="a-card"><nav class="flex gap-1 px-3 border-b border-neutral-200"><% ['pending','approved','rejected'].forEach((s) => { %><a class="a-tab <%= status === s ? 'a-tab-on' : '' %>" href="?status=<%= s %>"><%= s[0].toUpperCase() + s.slice(1) %> (<%= counts[s] || 0 %>)</a><% }) %></nav>
  <div class="divide-y"><% list.forEach((r) => { %><div class="p-4 flex flex-wrap gap-4 justify-between"><div class="max-w-2xl"><p class="text-sm"><b><%= r.customer_name %></b> <span class="text-neutral-500">&middot; <%= r.city || '' %> &middot; <%= r.product_slug %> &middot; <%= d(r.created_at) %></span></p><p class="text-gold">&#9733; <%= r.rating %>/5 <b class="text-ink"><%= r.title %></b></p><p class="text-sm text-neutral-700"><%= r.body %></p>
      <% if (r.photoUrl) { %><img src="<%= r.photoUrl %>" alt="Review photo from <%= r.customer_name %>" class="mt-3 w-24 h-24 object-cover rounded-lg border"><% } %>
      <form method="post" action="/admin/website/reviews/<%= r.id %>/photo" enctype="multipart/form-data" class="mt-3 flex flex-wrap items-end gap-2"><input type="hidden" name="_csrf" value="<%= csrf %>"><div><label class="a-lbl" for="review-photo-<%= r.id %>"><%= r.photoUrl ? 'Replace review photo' : 'Add review photo' %></label><input class="a-in" id="review-photo-<%= r.id %>" type="file" name="file" accept="image/jpeg,image/png,image/webp"></div><div><label class="a-lbl" for="review-link-<%= r.id %>">Or public image link</label><input class="a-in" id="review-link-<%= r.id %>" name="link_image" placeholder="Drive image link"></div><button class="a-btn-o">Save photo</button></form>
      <% if (r.photoUrl) { %><form method="post" action="/admin/website/reviews/<%= r.id %>/photo/remove" class="mt-2"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="a-btn-r">Remove photo</button></form><% } %>
    </div>
    <div class="flex gap-2 items-start"><% if (status !== 'approved') { %><form method="post" action="/admin/website/reviews/<%= r.id %>/approve"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="a-btn">Approve</button></form><% } %><% if (status !== 'rejected') { %><form method="post" action="/admin/website/reviews/<%= r.id %>/reject"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="a-btn-o">Reject</button></form><% } %><form method="post" action="/admin/website/reviews/<%= r.id %>/delete" data-confirm="Delete review?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="a-btn-r">Delete</button></form></div></div><% }) %>
  <% if (!list.length) { %><p class="p-10 text-center text-neutral-500">Nothing here. Reviews arrive when customers use the link in the post-delivery WhatsApp message.</p><% } %></div></div>
<%- include('partials/bottom') %>
