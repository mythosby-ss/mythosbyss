<%- include('partials/top') %>
<div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
  <div class="xl:col-span-2 space-y-6">
    <section class="a-card p-5">
      <div class="flex flex-wrap items-start justify-between gap-3"><div><h2 class="a-h"><%= o.id %></h2><p class="text-sm text-neutral-500">Placed <%= dt(o.created_at) %></p></div><div class="flex gap-2"><%- pill(o.status) %> <%- pill(o.payment_status) %></div></div>
      <table class="a-table mt-4"><thead><tr><th>Item</th><th>SKU</th><th>Qty</th><th>Price</th><th>Total</th></tr></thead><tbody>
        <% o.items.forEach((i) => { %><tr><td><%= i.product_name %> <span class="text-neutral-500">(<%= i.variant_label %>)</span><% if (i.components) { %><br><span class="text-xs text-neutral-500">Bundle: <%= JSON.parse(i.components).map((c) => c.name + (c.label ? ' (' + c.label + ')' : '') + ' ×' + c.qty).join(', ') %></span><% } %></td><td><%= i.sku %></td><td><%= i.qty %></td><td><%= money(i.unit_price) %></td><td><%= money(i.unit_price * i.qty) %></td></tr><% }) %></tbody></table>
      <dl class="mt-4 ml-auto max-w-xs text-sm space-y-1">
        <div class="flex justify-between"><dt>Subtotal</dt><dd><%= money(o.subtotal) %></dd></div>
        <% const prepaidOff = o.prepaid_discount || 0; const offerOff = o.offer_discount || 0; const couponOff = (o.discount || 0) - prepaidOff - offerOff; %>
        <% if (couponOff > 0) { %><div class="flex justify-between text-green-700"><dt>Discount <%= o.coupon_code ? '(' + o.coupon_code + ')' : '' %></dt><dd>-<%= money(couponOff) %></dd></div><% } %>
        <% if (offerOff > 0) { %><div class="flex justify-between text-green-700"><dt>Quantity offer</dt><dd>-<%= money(offerOff) %></dd></div><% } %>
        <% if (prepaidOff > 0) { %><div class="flex justify-between text-green-700"><dt>Prepaid discount</dt><dd>-<%= money(prepaidOff) %></dd></div><% } %>
        <div class="flex justify-between"><dt>Shipping</dt><dd><%= money(o.shipping_fee) %></dd></div>
        <% if (o.cod_fee) { %><div class="flex justify-between"><dt>COD fee</dt><dd><%= money(o.cod_fee) %></dd></div><% } %>
        <div class="flex justify-between font-semibold border-t pt-1"><dt>Total</dt><dd><%= money(o.total) %></dd></div>
        <div class="flex justify-between"><dt>Paid online</dt><dd><%= money(['paid','advance_paid','refunded','partially_refunded'].includes(o.payment_status) ? o.pay_now : 0) %></dd></div>
        <div class="flex justify-between"><dt>To collect on delivery</dt><dd><%= money(o.status === 'delivered' ? 0 : o.due_on_delivery) %></dd></div>
        <% if (o.refunded) { %><div class="flex justify-between text-red-600"><dt>Refunded</dt><dd>-<%= money(o.refunded) %></dd></div><% } %>
      </dl>
    </section>

    <section class="a-card p-5"><h2 class="a-h mb-4">Timeline</h2>
      <ol class="space-y-3 text-sm"><% o.events.forEach((e) => { %><li class="flex gap-3"><span class="mt-1.5 w-2 h-2 rounded-full bg-adm-blue shrink-0"></span><div><b><%= e.status ? statusLabel[e.status] : 'Note' %></b> <span class="text-neutral-500">&middot; <%= dt(e.at) %> &middot; <%= e.actor %></span><% if (e.note) { %><p class="text-neutral-600"><%= e.note %></p><% } %></div></li><% }) %></ol></section>

    <section class="a-card overflow-x-auto"><h2 class="a-h p-5 pb-3">WhatsApp messages</h2>
      <table class="a-table"><thead><tr><th>When</th><th>Template</th><th>Status</th><th>Error</th></tr></thead><tbody><% o.logs.forEach((l) => { %><tr><td><%= dt(l.created_at) %><% if (l.status === 'scheduled') { %><br><span class="text-xs text-neutral-500">due <%= dt(l.send_at) %></span><% } %></td><td><%= l.template %></td><td><%- pill(l.status) %></td><td class="text-red-600"><%= l.error || '' %></td></tr><% }) %><% if (!o.logs.length) { %><tr><td colspan="4" class="text-neutral-500">No messages yet.</td></tr><% } %></tbody></table></section>
  </div>

  <div class="space-y-6">
    <% if (o.status === 'ndr' || o.ndrNotes.length) { %>
    <section class="a-card p-5 border-amber-200 bg-amber-50/40"><h2 class="a-h">Failed delivery (NDR)</h2>
      <p class="text-sm text-neutral-600 mt-1">Attempts: <b><%= o.ndr_count || 0 %></b><%= o.ndr_reason ? ' · Courier says: ' + o.ndr_reason : '' %></p>
      <% if (o.status === 'ndr') { %>
      <div class="flex flex-wrap gap-2 mt-3"><a class="a-btn-o !border-green-300 !text-green-800" href="/admin/orders/<%= o.id %>/whatsapp-ndr" target="_blank" rel="noopener">Ask customer on WhatsApp</a><a class="a-btn-o" href="tel:+91<%= o.phone %>">Call <%= o.phone %></a></div>
      <form method="post" action="/admin/orders/<%= o.id %>/ndr-note" class="mt-3 space-y-2">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <label class="a-lbl" for="ndr-reply">Customer's answer</label>
        <select class="a-in" id="ndr-reply" name="reply"><% shipInfo.ndrReplies.forEach((r) => { %><option><%= r %></option><% }) %></select>
        <input class="a-in" name="detail" placeholder="Details, e.g. 'nobody called, I was home all day' / 'deliver after 6 pm'">
        <button class="a-btn w-full">Save reply</button>
      </form>
      <% } %>
      <% if (o.ndrNotes.length) { %><ul class="mt-3 text-sm space-y-1"><% o.ndrNotes.forEach((n) => { %><li><span class="text-neutral-500"><%= dt(n.at) %> &middot; attempt <%= n.attempt %> &middot; <%= n.courier %>:</span> <%= n.reply %><%= n.detail ? ' - ' + n.detail : '' %></li><% }) %></ul><% } %>
    </section>
    <% } %>
    <% if (o.status === 'pending_confirmation') { %>
    <section class="a-card p-5 border-purple-200 bg-purple-50/40"><h2 class="a-h">Confirm this COD order</h2>
      <p class="text-sm text-neutral-600 mt-1">It cannot be shipped until it is confirmed with the customer.</p>
      <div class="flex flex-wrap gap-2 mt-3"><a class="a-btn-o !border-green-300 !text-green-800" href="/admin/orders/<%= o.id %>/whatsapp-confirm" target="_blank" rel="noopener">Message on WhatsApp</a><a class="a-btn-o" href="tel:+91<%= o.phone %>">Call <%= o.phone %></a></div>
    </section>
    <% } %>
    <section class="a-card p-5"><h2 class="a-h mb-3">Update status</h2>
      <% if (next.length) { %>
      <% next.forEach((s) => { %>
      <form method="post" action="/admin/orders/<%= o.id %>/status" class="border-t first:border-0 py-3 space-y-2" <% if (s === 'cancelled' || s === 'rto') { %>data-confirm="Are you sure? Stock will be restored."<% } %>>
        <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="status" value="<%= s %>">
        <% if (s === 'shipped' && o.status === 'ndr') { %>
          <input type="hidden" name="note" value="Re-attempt requested with the courier">
        <% } else if (s === 'shipped') { %>
          <p class="text-xs text-neutral-500">Shipping: <%= shipInfo.provider %></p>
          <div class="grid grid-cols-2 gap-2"><div><label class="a-lbl">Courier</label><input class="a-in" name="courier" list="courier-list" value="<%= o.courier || '' %>" placeholder="e.g. Delhivery" required><datalist id="courier-list"><% shipInfo.couriers.forEach((c) => { %><option value="<%= c %>"><% }) %></datalist></div><div><label class="a-lbl">AWB</label><input class="a-in" name="awb" value="<%= o.awb || '' %>" required></div></div>
          <div><label class="a-lbl">Courier charge (your cost)</label><input class="a-in" type="number" step="0.01" name="courier_charge" value="<%= o.courier_charge || '' %>"></div>
        <% } %>
        <% if (s === 'cancelled' || s === 'rto' || s === 'returned') { %><input class="a-in" name="note" placeholder="Reason (optional)"><% } %>
        <% if (s === 'returned') { %><p class="text-xs text-neutral-500">Stock is not restored automatically (check the item first). Record the refund and reverse-pickup charge below.</p><% } %>
        <% if (s === 'ndr') { %><input class="a-in" name="note" placeholder="Courier's reason, e.g. customer not available"><% } %>
        <button class="<%= ['cancelled', 'rto', 'returned'].includes(s) ? 'a-btn-r' : 'a-btn' %> w-full"><%= s === 'shipped' && o.status === 'ndr' ? 'Re-attempt requested' : 'Mark as ' + statusLabel[s] %></button>
      </form>
      <% }) %>
      <p class="text-xs text-neutral-500">Shipped, out-for-delivery and delivered updates are sent to the customer on WhatsApp automatically.</p>
      <% } else { %><p class="text-sm text-neutral-500">This order is <%= statusLabel[o.status].toLowerCase() %> and cannot change further.</p><% } %>
    </section>

    <section class="a-card p-5 text-sm"><h2 class="a-h mb-3">Customer</h2>
      <p><b><%= o.name %></b></p><p><%= o.phone %> &middot; <%= o.email %></p>
      <p class="mt-1 text-xs"><% if (o.risk.rtoCount) { %><span class="pill-red"><%= o.risk.rtoCount %> past RTO<%= o.risk.rtoCount > 1 ? 's' : '' %></span><% } else { %><span class="pill-green">No past RTO</span><% } %>
        <% if (o.risk.blacklisted) { %> <span class="pill-red">COD blacklisted</span><% } %> <a class="underline text-neutral-500 ml-1" href="/admin/settings/cod#phones">COD rules</a></p>
      <p class="mt-2"><%= o.address %>, <%= o.city %>, <%= o.state %> - <%= o.pincode %></p>
      <% if (o.note) { %><p class="mt-2 text-neutral-600">Note: <%= o.note %></p><% } %>
      <% if (o.preferred_language) { %><p class="mt-2">Preferred language: <b><%= o.preferred_language %></b></p><% } %>
      <p class="mt-2 text-xs text-neutral-500">Source: <%= o.utm_source || 'direct' %><%= o.utm_campaign ? ' / ' + o.utm_campaign : '' %><%= o.utm_content ? ' / ' + o.utm_content : '' %></p>
      <a class="a-btn-o mt-3" target="_blank" href="/admin/orders/<%= o.id %>/label">Print label</a> <a class="a-btn-o mt-3" target="_blank" href="/admin/orders/<%= o.id %>/invoice">Tax invoice</a> <a class="a-btn-o mt-3" href="/admin/customers/<%= o.customer_id %>">Customer</a>
    </section>

    <section class="a-card p-5"><h2 class="a-h mb-3">Logistics</h2>
      <form method="post" action="/admin/orders/<%= o.id %>/logistics" class="space-y-2">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div><label class="a-lbl">Courier</label><input class="a-in" name="courier" value="<%= o.courier || '' %>"></div>
        <div><label class="a-lbl">AWB / tracking number</label><input class="a-in" name="awb" value="<%= o.awb || '' %>"></div>
        <div><label class="a-lbl">Courier charge (forward)</label><input class="a-in" type="number" step="0.01" name="courier_charge" value="<%= o.courier_charge || 0 %>"></div>
        <div class="grid grid-cols-3 gap-2">
          <div><label class="a-lbl">RTO charge</label><input class="a-in" type="number" step="0.01" min="0" name="rto_charge" value="<%= o.rto_charge ?? '' %>"></div>
          <div><label class="a-lbl">COD fee</label><input class="a-in" type="number" step="0.01" min="0" name="courier_cod_charge" value="<%= o.courier_cod_charge ?? '' %>"></div>
          <div><label class="a-lbl">Reverse pickup</label><input class="a-in" type="number" step="0.01" min="0" name="reverse_pickup_charge" value="<%= o.reverse_pickup_charge ?? '' %>"></div>
        </div>
        <p class="text-xs text-neutral-400">Courier's charges to you. Used for the RTO / return loss in the daily report. Leave empty if not known yet.</p>
        <button class="a-btn-o w-full">Save logistics</button>
      </form></section>

    <% if (o.refunded < o.total && o.status !== 'awaiting_payment') { %>
    <section class="a-card p-5"><h2 class="a-h mb-3">Refund</h2>
      <form method="post" action="/admin/orders/<%= o.id %>/refund" class="space-y-2" data-confirm="Record this refund? Razorpay refunds cannot be undone.">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div><label class="a-lbl">Amount (max <%= money(o.total - o.refunded) %>)</label><input class="a-in" type="number" step="0.01" name="amount" value="<%= o.status === 'cancelled' ? o.pay_now - o.refunded : '' %>" required></div>
        <div><label class="a-lbl">Method</label><select class="a-in" name="method"><% if (rzpOn && o.razorpay_payment_id) { %><option value="razorpay">Razorpay (to original payment)</option><% } %><option value="manual">Manual (already refunded / cash / UPI)</option></select></div>
        <div><label class="a-lbl">Reason</label><input class="a-in" name="reason"></div>
        <button class="a-btn-r w-full">Issue refund</button>
      </form></section>
    <% } %>
  </div>
</div>
<%- include('partials/bottom') %>
