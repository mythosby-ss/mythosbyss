<%- include('partials/header') %>
<section class="bg-white">
  <div class="container-x max-w-6xl py-10 sm:py-14 lg:py-16">
    <header class="mb-8 text-center sm:mb-10">
      <p class="mb-2 text-xs font-semibold uppercase tracking-[0.22em] text-gold-dark">MythosBySS</p>
      <h1 class="text-3xl font-semibold tracking-tight text-neutral-500 sm:text-4xl lg:text-[2.65rem]"><%= page.title %></h1>
      <div class="mx-auto mt-4 h-1 w-14 rounded-full bg-gold"></div>
    </header>
    <% if (page.intro && page.intro.length) { %>
      <div class="space-y-5 text-[15px] leading-7 text-neutral-700 sm:text-base sm:leading-7">
        <% page.intro.forEach((paragraph) => { %><p><%- paragraph %></p><% }) %>
      </div>
    <% } %>
    <% if (page.sections && page.sections.length) { %>
      <div class="mt-8 space-y-7 sm:mt-10 sm:space-y-8">
        <% page.sections.forEach((section) => { %>
          <section class="border-b border-neutral-100 pb-6 last:border-0 last:pb-0">
            <% if (section.heading) { %><h2 class="mb-3 text-lg font-semibold text-neutral-600 sm:text-xl"><%= section.heading %></h2><% } %>
            <% if (section.paragraphs && section.paragraphs.length) { %>
              <div class="space-y-3 text-[15px] leading-7 text-neutral-700 sm:text-base">
                <% section.paragraphs.forEach((paragraph) => { %><p><%- paragraph %></p><% }) %>
              </div>
            <% } %>
            <% if (section.list && section.list.length) { %>
              <% if (section.ordered) { %>
                <ol class="mt-3 list-decimal space-y-1.5 pl-6 text-[15px] leading-6 text-neutral-600 sm:text-base"><% section.list.forEach((item) => { %><li class="pl-1"><%= item %></li><% }) %></ol>
              <% } else { %>
                <ul class="mt-3 list-disc space-y-1.5 pl-6 text-[15px] leading-6 text-neutral-600 sm:text-base"><% section.list.forEach((item) => { %><li class="pl-1"><%= item %></li><% }) %></ul>
              <% } %>
            <% } %>
          </section>
        <% }) %>
      </div>
    <% } %>
    <div class="mt-10 flex flex-col gap-3 rounded-2xl border border-neutral-200 bg-neutral-50 p-5 sm:flex-row sm:items-center sm:justify-between sm:p-6">
      <div><p class="font-semibold text-neutral-900">Need help with your order?</p><p class="mt-1 text-sm leading-6 text-neutral-600">Our team can help with product, delivery and policy questions.</p></div>
      <a href="/pages/contact" class="btn-dark shrink-0">Contact us</a>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
