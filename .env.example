# Copy to .env and fill in what you have. Never commit .env.
# Anything left empty is either optional or runs in a safe "simulated/manual" mode locally.

# --- App ---
PORT=3000
NODE_ENV=development
SITE_URL=http://localhost:3000
# Long random string, required in production (e.g. output of: openssl rand -hex 32)
SESSION_SECRET=

# --- Database (Turso / libSQL). Leave empty to use the local file data/mythosbyss.db ---
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# (older names, also accepted)
DB_URL=
DB_TOKEN=

# --- Admin panel (/admin) ---
ADMIN_USER=
ADMIN_PASS=

# --- Razorpay (https://dashboard.razorpay.com/app/keys) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Checkout defaults (can also be changed in Admin > Settings) ---
PARTIAL_COD_PERCENT=
COD_FEE=
SHIPPING_FEE=
REVIEW_DELAY_HOURS=

# --- WhatsApp Cloud API (login OTP + order updates). Empty = simulated (codes printed in the server console in development) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=
WA_TEMPLATE_LANG=
WA_TPL_OTP=
WA_TPL_CONFIRMED=
WA_TPL_SHIPPED=
WA_TPL_OFD=
WA_TPL_DELIVERED=
WA_TPL_REVIEW=

# --- Courier status webhook (POST /webhooks/shipping, header x-webhook-secret) ---
SHIPPING_WEBHOOK_SECRET=

# --- Meta Pixel + Conversions API ---
# Pixel ID (Events Manager > Data sources > your Pixel)
META_PIXEL_ID=
# Conversions API token (Events Manager > your Pixel > Settings > Generate access token)
META_CAPI_TOKEN=
# Only while testing: code from Events Manager > Test events. Remove for live traffic.
META_TEST_EVENT_CODE=
META_API_VERSION=
# GA4 Measurement Protocol secret (optional, server-side GA4 purchase)
GA4_API_SECRET=

# --- Meta (ads reporting) ---
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# --- Google Ads (optional reporting sync) ---
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=

# --- Google Drive (product images / UGC videos) ---
DRIVE_API_KEY=
DRIVE_ROOT_FOLDER_ID=
DRIVE_IMAGES_FOLDER_ID=
UGC_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Login OTP delivery (lib/otp.js) ---
# whatsapp (production default) | sms (not wired yet) | dev (development default: static code, never active in production)
OTP_PROVIDER=
# Static code accepted in development when OTP_PROVIDER=dev (default 123456789)
DEV_STATIC_OTP=

# --- Shipping (lib/shipping) ---
# manual (default: courier + AWB entered by hand) | shiprocket | shipway (placeholders until connected)
SHIPPING_PROVIDER=
# Your logistics partner's API details (Admin -> Plugins -> Logistics fills these in)
LOGISTICS_PARTNER=
LOGISTICS_API_USER=
LOGISTICS_API_KEY=
LOGISTICS_PICKUP_PINCODE=

# ---- Hosting (Hostinger) ----
# Folder for photos uploaded in admin. Put it OUTSIDE the app folder so a redeploy can't delete them,
# e.g. /home/<your-user>/mythosbyss-uploads . Empty = public/images/uploads inside the app.
UPLOAD_DIR=
# Proxies in front of the app: 1 = Hostinger web server only; 2 = with the Hostinger CDN (or Cloudflare) on.
TRUST_PROXY=1
# Owner emails + ops agents (lib/mailer.js, lib/owner-mail.js). Email is sent over SMTP from your own mailbox
# (e.g. Hostinger email for mythosbyss.com: host smtp.hostinger.com, port 465). Leave empty = emails off.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Owner's inbox for the new-order email and the daily report (Admin > Settings > Ops & owner emails can override it)
OWNER_EMAIL=
# Optional: secret for an external cron trigger of the daily report (GET /cron/daily-report with header x-cron-key)
CRON_SECRET=
# Shipway API (Shipway > Settings > API) for npm run ops:shipway - not connected yet
SHIPWAY_USERNAME=
SHIPWAY_LICENSE_KEY=
