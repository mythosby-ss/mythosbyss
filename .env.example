PORT=3000
NODE_ENV=development
SITE_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string

# Razorpay (https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=optional-webhook-secret

# Checkout rules
PARTIAL_COD_PERCENT=20     # % of order value paid online for "Partial COD"
COD_FEE=0                  # extra rupees charged on COD / Partial COD
SHIPPING_FEE=0             # flat shipping (storefront promises free shipping)

# Admin panel (/admin) - HTTP basic auth
ADMIN_USER=admin
ADMIN_PASS=change-this-password
